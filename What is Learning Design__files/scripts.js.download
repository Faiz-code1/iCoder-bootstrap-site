// Animation scripts
// Adaptivity page animation
(function ($, root, undefined) {
  'use strict';

  $(function() {
    //set animation timing
    var animationDelay = 3000;
    initHeadline();

    function initHeadline() {
      //initialise headline animation
      animateHeadline($('.state-cards-item:first-child .state-cards-statelist'), 3000);
      animateHeadline($('.state-cards-item:last-child .state-cards-statelist'), 3140);
    }

    function animateHeadline($headlines, delay) {
      var duration = delay;
      $headlines.each(function(){
        var headline = $(this);

        //trigger animation
        setTimeout(function(){
          hideWord(headline.find('.is-visible').eq(0));
        }, duration);
      });
    }

    function hideWord($word) {
      var nextWord = takeNext($word);

      switchWord($word, nextWord);
      setTimeout(function() {
        hideWord(nextWord);
      }, animationDelay);
    }

    function takeNext($word) {
      return (!$word.is(':last-child')) ? $word.next() : $word.parent().children().eq(0);
    }

    function switchWord($oldWord, $newWord) {
      $oldWord.removeClass('is-visible').addClass('is-hidden');
      $newWord.removeClass('is-hidden').addClass('is-visible');
    }
  });
})(jQuery, this);

// Hero Animations
(function ($, root, undefined) {
  'use strict';

  // Trigger homepage hero animation
  $(function() {
    $("#hero-section .hero-wrapper").addClass("anim-start");
  });

  // Scroll to first feature section
  $(".scroll-prompt").click(function(e) {
    e.preventDefault();
    $('html, body').animate({
      scrollTop: $(".scroll-prompt").offset().top
    }, 800);
  });

})(jQuery, this);

// Reveal animations

// Declare this gloabally so it can be called from other IIFEs
var revealItems;

(function ($, root, undefined) {
  'use strict';

  $(function() {

    revealItems = function(element) {
      // Array shuffler by Jonas Raoni Soares Silva
      //@ http://jsfromhell.com/array/shuffle [v1.0]
      var shuffle = function(o){ //v1.0
        for(var j, x, i = o.length; i; j = parseInt(Math.random() * i), x = o[--i], o[i] = o[j], o[j] = x);
        return o;
      };

      // Create an array from the number of elements
      var items = [];
      for (var i = 0; i < element.length; i++ ) {
        items.push(i);
      }

      // Shuffle the array
      // items = shuffle(items);
      var index = 0;

      // Fade in a random element in the grid
      var fadeInCards = setInterval(function() {
        if (index <= items.length) {
          $('.card__item:eq('+(items[index++])+')').removeClass('card__item--hidden');
        } else {
          clearInterval(fadeInCards);
        }
      }, 50);
    };
  });
})(jQuery, this);


$(document).on('click', '.pillar a[href^="#"]', function (event) {
    event.preventDefault();

    $('html, body').animate({
        scrollTop: $($.attr(this, 'href')).offset().top
    }, 500);
});


$('.nav-link').click(function()
{
    $('a').removeClass('active');
    $('.nav_' + $(this).attr('href').replace('#', '')).addClass('active');
});


$('.pillar__toggleButton').click(function() {
    $('#menu').slideToggle('1000');
    $('#open, #closed').toggle();
});


// Component partials
// Scroll animations
(function ($, root, undefined) {
  'use strict';

  // Basic reveal elements on scroll
  function scrollReveal(element, wScroll) {
    for (var i = 0; i < element.length; i ++) {
      var elementTopToPageTop = $(element[i]).offset().top,
          windowTopToPageTop = wScroll,
          distanceFromBottomToAppear = elementTopToPageTop - ($(window).height() / 1.25);

      if (windowTopToPageTop > distanceFromBottomToAppear) {
        $(element[i]).addClass('js-fade-element-show');
        $(element[i]).removeClass('js-fade-element-hide');
      }
    }
  }

  // Apply animation class to elements on scroll
  function scrollAnimate(element, wScroll) {
    for (var i = 0; i < element.length; i ++) {
      var elementTopToPageTop = $(element[i]).offset().top
      var windowTopToPageTop = wScroll;
      var windowInnerHeight = window.innerHeight;
      var elementTopToWindowTop = elementTopToPageTop - windowTopToPageTop;
      var elementTopToWindowBottom = windowInnerHeight - elementTopToWindowTop;
      var distanceFromBottomToAppear = elementTopToPageTop - ($(window).height() / 1.6);
      var elementTopToWindowBottom = windowInnerHeight - elementTopToWindowTop;

      if (windowTopToPageTop > distanceFromBottomToAppear) {
        $(element[i]).addClass('is-animating');
      } else if(elementTopToWindowBottom < 0) {
        $(element[i]).removeClass('is-animating');
      }
    }
  }

  // Hide an element once it scrolls past another element's position
  function scrollHideOnElement(element, hideElement, wScroll) {
    var elementTopToPageTop = $(hideElement).offset().top,
        windowTopToPageTop = wScroll,
        distanceFromBottomToAppear = elementTopToPageTop - ($(window).height() / 1.25);

    if (windowTopToPageTop > distanceFromBottomToAppear) {
      $(element).addClass('is-hidden');
    } else {
      $(element).removeClass('is-hidden');
    }
  }

  // Apply highlighted class to post actions
  function postActionsScroll(wScroll) {
    var elementTopToPageTop = $('.author-profile').offset().top,
        windowTopToPageTop = wScroll,
        distanceFromBottomToAppear = elementTopToPageTop - ($(window).height());

    if (windowTopToPageTop > distanceFromBottomToAppear) {
      $('.postActions').addClass('postActions--highlighted');
    } else {
      $('.postActions').removeClass('postActions--highlighted');
    }
  }

  // Hide elements after scrolling past itself
  function scrollHideOnSelf(element, wScroll) {
    var elementTopToPageTop = $(element).offset().top,
        distanceFromTopToFade = elementTopToPageTop - 300;

    if (wScroll > distanceFromTopToFade) {
      $(element).css({
        'opacity' : 0
      });
    } else if (wScroll < distanceFromTopToFade) {
      $(element).css({
        'opacity' : 1
      });
    }
  }

  function pos(base, range, relY, offset) {
    return base + limit(0, 1, relY - offset) * range;
  }

  function limit(min, max, value) {
    return Math.max(min, Math.min(max, value));
  }

  // Parallax scroll effect
  function scrollParallax(element, factor, wScroll) {
    if ($(element).length > 0 && $(window).width() > 768) {
      $(element).css({
        'transform' : 'translate3d(0,' + pos(0, factor, wScroll, 0) + 'px, 0)',
        'opacity' : 1 - wScroll * 7,
        'animation' : 'none'
      });
    }
  }

  // Apply keyframe css animation to nav on scroll
  function scrollNav(wScroll) {
    if ($('.header').hasClass('header--noScroll')) return;
    if (wScroll > 50) {
      // $('.header').addClass('header--scrolled');
      $('.header.static').addClass('header--static');
      $('.btt').removeClass('invisible');
    } else if (wScroll < 50) {
      // $('.header').removeClass('header--scrolled');
      $('.header.static').removeClass('header--static');
      $('.btt').addClass('invisible');
    }
  }


  // Handle scroll functions, debouncing them from the event with requestAnimationFrame
  var latestKnownScrollTop = 0,
    ticking = false;

  function onScroll() {
    latestKnownScrollTop = $(window).scrollTop();
    requestTick();
  }

  function update() {
    var wScroll = latestKnownScrollTop;
    var relativeY = wScroll / 3000;
    ticking = false;

    scrollNav(wScroll);

    // Page specific scroll functions
    if ($('body').hasClass('home')) {
      scrollReveal($('.main-feature'), wScroll);
      scrollHideOnSelf($('.scroll-prompt'), wScroll);

      if (wScroll < 525) {
        scrollParallax($('.students-grid'), 1800, relativeY);
        scrollParallax($('.hero-content h1'), 1200, relativeY);
        scrollParallax($('.hero-content p'), 1200, relativeY);
        scrollParallax($('.hero-content .hero-actions .button'), 1200, relativeY);
        scrollParallax($('.hero-content .hero-actions label'), 1200, relativeY);
      }
    } else if ($('body').hasClass('post')) {
      scrollParallax($('.post-header-content'), 1200, relativeY);
      postActionsScroll(wScroll);
    } else if ($('body').hasClass('demo')) {
      scrollParallax($('.study-header-details'), 1200, relativeY);
    } else if ($('body').hasClass('studio')) {
      scrollParallax($('.hero-content'), 1200, relativeY);
    } else if ($('body').hasClass('product')) {
      scrollAnimate($('.features-image'), wScroll)
    }
  }

  function requestTick() {
    if(!ticking) {
      requestAnimationFrame(update);
    }
    ticking = true;
  }

  $(function() {
    window.addEventListener('scroll', onScroll);
  });
})(jQuery, this);

// Modals
(function ($, root, undefined) {
  'use strict';

  $(function() {

    function showModal(modalName) {
      var modalToggle = $(modalName),
        videoWrapper = $(modalName + " + .modal-fade-screen .video-wrapper"),
        videoSRC = modalToggle.attr("data-Video") + "&autoplay=1";

      modalToggle.on("change", function() {
        if ($(this).is(":checked")) {
          $(videoWrapper).html('<iframe src="' + videoSRC + '" frameborder="0" allowfullscreen></iframe>');
          $("body").addClass("modal-open");
        } else {
          $("body").removeClass("modal-open");
        }
      });

      function closeModal(){
        $(videoWrapper).html('');
        $(modalName + ".modal-state:checked").prop("checked", false).change();
      }

      $(modalName + " + .modal-fade-screen," + modalName + " + .modal-fade-screen .modal-close").on("click", function() {
        closeModal();
      });

      $(document).keyup(function(e) {
        if (e.keyCode == 27 && $("body").hasClass("modal-open")) {
          closeModal();
        }
      });

      $(modalName + " + .modal-fade-screen .modal-inner").on("click", function(e) {
        e.stopPropagation();
      });
    }

    // Call functions for new video modals
    showModal("#video-spr");
    showModal("#video-mike");
    showModal("#video-liz");


    // Base modals
    var generalModal = $('.modal.base');

    generalModal.find(".modal-state").on("change", function() {
      $("body").toggleClass("modal-open");
    });

    generalModal.find('.modal-fade-screen').on("click", function() {
      $(this).parent().find(".modal-state:checked").prop("checked", false).change();
    });

    generalModal.find('.modal-inner').on("click", function(e) {
      e.stopPropagation();
    });

    generalModal.find('.modal-close').on("click", function() {
      $(this).parents().find(".modal-state:checked").prop("checked", false).change();
    });

    $(document).keyup(function(e) {
      if (e.keyCode == 27) {
        $(".modal.base .modal-state:checked").prop("checked", false).change();
      }
    });
  });
})(jQuery, this);

// Forms
(function ($, root, undefined) {
  'use strict';

  // Remove local path from file uploads
  $('input[type=file]').change(function (e) {
