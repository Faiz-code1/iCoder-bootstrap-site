    self.next().html(self.val());
    $(".filename").text(self.val().split('\\').pop());
  });

})(jQuery, this);

(function ($, root, undefined) {
  'use strict';

  $(function() {
    $(".dropdown-button").click(function(e) {
      var self = $(this);
      var menu = self.siblings(".dropdown-menu");
      menu.toggleClass("show-menu");
      e.stopPropagation();
      e.preventDefault();
