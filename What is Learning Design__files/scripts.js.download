})(jQuery, this);

// Show suggested articles
(function ($, root, undefined) {
  'use strict';

  $.fn.shuffleStudies = function(element) {
    return this.each(function() {
      var $this = $(this);
      var elems = $this.children(element);

      elems.sort(function() { return (Math.round(Math.random())-0.5); });

      $this.detach(element);

      for (var i=0; i < element.length; i++) {
        $this.append(elems[i]);
      }
    });
  };

  $(function() {
    if( $(".demo").length) {
      $(".card").shuffleStudies(".card__item");
      $('.card .card__item:gt(2)').remove();
    }
  });
})(jQuery, this);

var CategoryFilter = (function() {
  'use strict';

  function CategoryFilter(options) {
    this.data = options.data;
    this.filters = options.filters;
    this.item = options.item;
    this.filterableItems = options.filterableItems;
    this.filterableItemHiddenClass = options.filterableItemHiddenClass;
    this.initialSelection = options.initialSelection;
    this.noResults = options.noResults;
    this.popoverTrigger = this.filters.find('[data-filter-toggle]');
    this.applyFilterButton = this.filters.find('[data-filter]');
    this.filterPopovers = this.filters.find('.popover');
    this.searchInput = this.filters.find('[data-search]');
    this.filterSet = this.initialSelection;
    this.query = this.searchInput.val();

    this.updateSelection();
    this.applyFilter();
    this.bindEvents();
  }

  CategoryFilter.prototype.bindEvents = function() {
    var self = this;
    var oldValue = this.searchInput.val();

    this.searchInput.on('keyup', function() {
      var newValue = self.searchInput.val();
      if (newValue !== oldValue) {
        self.query = newValue;
        self.applyFilter();
      }

      oldValue = newValue;
    });

    this.popoverTrigger.on('click', function(e) {
      e.preventDefault()
      e.stopPropagation();

      var popoverMenu = $(this).next('.popover').find('.popover__menu');
      var isOpen = popoverMenu.hasClass('popover__menu--visible');

      if (isOpen) {
        self.closePopovers();
      } else {
        self.closePopovers();
        $(this).next('.popover').find('.popover__menu').toggleClass('popover__menu--visible');
      }
    });

    this.applyFilterButton.on('click', function(e) {
      self.closePopovers();
      e.preventDefault()
      e.stopPropagation();

      var filterType = $(this).data('filter');
      var filterValue = $(this).data('value');

      self.updateFilters(filterType, filterValue);
    });

    $(document).on('click', function() {
      self.closePopovers();
    });
  };

  CategoryFilter.prototype.renderItems = function(data, search) {
    var self = this;
    var item = this.item;
    this.filterableItems.empty();

    $.each(data, function(index, value){
      var renderedItem = new item(value).render();
      self.filterableItems.append(renderedItem);
    });

    if (!search) {
      this.revealItems(this.filterableItems.contents());
    } else {
      this.filterableItems.contents().removeClass(self.filterableItemHiddenClass);
    }
  },

  CategoryFilter.prototype.updateFilters = function(type, value) {
    this.filterSet[type] = value;

    this.updateSelection();
    this.applyFilter();
  };

  CategoryFilter.prototype.updateSelection = function() {
    var self = this;
    this.applyFilterButton.removeClass('popover__link--selected');

    $.each(this.filterSet, function(key, value) {
      var valueText = self.filters.find('[data-filter="' + key + '"][data-value="' + value + '"]').text();
      self.filters.find('[data-filter="' + key + '"][data-value="' + value + '"]').addClass('popover__link--selected');
      self.filters.find('[data-filter-toggle="' + key + '"]').text(valueText);
    });
  };

  CategoryFilter.prototype.closePopovers = function() {
    this.filterPopovers.find('.popover__menu').removeClass('popover__menu--visible');
  };

  CategoryFilter.prototype.applyFilter = function() {
    var filteredContent = this.data;
    var search = this.query;

    this.filterableItems.empty();

    if (search) {
      filteredContent = this.search(search, filteredContent);
    }

    $.each(this.filterSet, function(key, value) {
      if (key !== 'sort' && value !== 'all') {
        filteredContent = filteredContent.filter(function(item) {
          return item[key].toLowerCase() === value.toLowerCase();
        });
      }
    });

    filteredContent = this.sortItems(filteredContent);

    if (filteredContent.length > 0) {
      this.noResults.hide();
      this.renderItems(filteredContent, search);
    } else {
      this.noResults.show();
    }
  };

  CategoryFilter.prototype.sortItems = function(content) {
    if (this.filterSet['sort'] === 'name') {
      content = content.sort(function(a, b) {
        var aName = a.title.toLowerCase();
        var bName = b.title.toLowerCase();
        return aName < bName ? -1 : aName > bName ? 1 : 0;
      });
    } else if (this.filterSet['sort'] === 'date') {
      content = content.sort(function(a, b) {
        var aDate = a.date;
        var bDate = b.date;
        return aDate > bDate ? -1 : aDate < bDate ? 1 : 0;
      });
    }

    return content;
  };

  CategoryFilter.prototype.revealItems = function(items) {
    var self = this;
    var index = 0;
    var itemsLength = items.length;
    var framesPerSecond = 30;

    function animate() {
      if (index <= itemsLength) {
        setTimeout(function() {
          window.requestAnimationFrame(animate);
          $(items[index++]).removeClass(self.filterableItemHiddenClass);
        }, 1000 / framesPerSecond);
      }
    }

    animate();
  }

  CategoryFilter.prototype.search = function(query, data) {
    var self = this;
    var results = window.idx.search(query);
    var searchEntries = [];
    var sortedData = data.sort(function(a, b) {
      return Number(a.index) > Number(b.index) ? 1 : -1;
    });

    results.forEach(function(result) {
      searchEntries.push(sortedData[result.ref]);
    });

    return searchEntries;
  };

  return CategoryFilter;
})();

var demoCard = (function() {
  'use strict';

  function demoCard(data) {
    this.url = data.url;
    this.title = data.title;
    this.avatar = data.avatar;
    this.subject = data.subject;
    this.subjectColor = data.subjectColor;
    this.image = data.image;
    this.demoCardStyle = data.demoCardStyle;
    this.quote = data.quote;
    this.institute = data.institute;
    this.author = data.author;
    this.authorCredentials = data.authorCredentials
    this.description = data.description;
    this.learningType = data.learningType;
    this.activityType = data.activityType;
  }

  demoCard.prototype.render = function() {
    var truncatedDescription = this.description.substring(0, 140);
    if(truncatedDescription.length == 140) {
      truncatedDescription += '...';
      console.log(truncatedDescription);
    }
    var iconActivity = '<svg class="card__statsIcon" fill="rgba(0, 0, 0, 0.4)" xmlns="http://www.w3.org/2000/svg" width="14" height="19" viewBox="0 0 14 19"><path fill-rule="evenodd" d="M9.45 14.14l2.103 4.202 1.79-.895-2.05-4.094 2.498-1.064L7 6v9.184l2.45-1.045zM13 8.407v-5.41C13 1.343 11.657 0 10 0H3C1.34 0 0 1.343 0 3v7c0 1.658 1.343 3 3 3h2v-2H2.998c-.55 0-.998-.446-.998-.998V2.998c0-.55.446-.998.998-.998h7.004c.55 0 .998.446.998.998v3.558l2 1.852z"/></svg>';
    var iconAdaptivity = '<svg class="card__statsIcon" fill="rgba(0, 0, 0, 0.4)" xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 14 14"><path fill-rule="evenodd" d="M11.7 10.3L6.4 5H0v2h5.6l4.7 4.7L8 14h6V8l-2.3 2.3zm.573-9.987l1.414 1.414-4.03 4.03L8.24 4.343l4.03-4.03z"/></svg>';

    var cardTop =  '<a href="' + this.url + '" data-url="' + this.url + '" data-trigger="preview-removethistoenablepreviewagain" class="card__item card__item--hidden">' +
                      '<div id="card-top">' +
                        '<h1 id="card-title">' + this.title + '</h1>' +
                        '<img id="card-arrow" src="/assets/img/card-arrow.png" width="16"/>' +
                      '</div>';
                  

    var cardMiddle;

    if(this.demoCardStyle == 'Quote') {
      cardMiddle = '<div class="card__thumbnail card-thumbnail-quote">' +
                      '<img id="card-image-quote" class="card__thumbnailImage" src="/assets/img/quotation-marks.png" alt="Picture of ' + this.title + '">' +
                      '<p>' + this.quote + '</p>' +
                      '<div class="card__hoverActions">' +
                      '</div>' +
                      '<div class="card__thumbnailProfile">' +
                        '<img class="card__thumbnailProfileAvatar" src="/assets/demos/avatars/' + this.avatar + '" alt="' + this.author + '">' +
                        '<p id="author"><span id="author-name">'+ this.author +'</span><br><span id="author-credentials">'+ this.authorCredentials +'</span></p>' + 
                      '</div>' +
                    '</div>' +
                    '<div class="card__content content-quote card__content--hasOverlapAvatar">';
    }
    else {
      cardMiddle = '<div class="card__thumbnail card__thumbnail--overlay">' +
                    '<img class="card__thumbnailImage" src="' + this.image + '" alt="Picture of ' + this.title + '">' +
                    '<div class="card__hoverActions">' +
                    '</div>' +
                  '</div>' +
                  '<p class="card__description">' + truncatedDescription + '</p>' +
                  '<div class="card__content card__content--hasOverlapAvatar">';
    }
  var cardBottom =  '<hr></hr>' +
                    '<h4 class="card__title">' + this.institute + '</h4>' +
                    '<div class="card__thumbnailTag" style="background-color:'+ this.subjectColor +';">'+ this.subject +'</div>' +
                  '</div>' +
                '</a>';
    return cardTop + cardMiddle + cardBottom;
  };

  return demoCard;
})();

(function ($, root, undefined) {
  'use strict';

  if ($('.demos').length) {
    // Initalize lunr with the fields it will be searching on
    window.idx = lunr(function() {
      this.ref('id');
      this.field('title', {boost: 10});
      this.field('subject', {boost: 10});
      this.field('description');
    });

    // Download the data from the JSON file we generated
    window.data = $.getJSON('/js/demos.json');

    // Wait for the data to load and add it to lunr
    window.data.then(function(loaded_data){
      $.each(loaded_data, function(index, value){
        window.idx.add(
          $.extend({ "id": index }, value)
        );
      });
    });

    window.data.then(function(data) {
      var categoryFilter = new CategoryFilter({
        filters: $('.categoryFilter'),
        data: data,
        item: demoCard,
        filterableItems: $('.demos'),
        filterableItemHiddenClass: 'card__item--hidden',
        noResults: $('.contentSection__emptyState'),
        initialSelection: {
          sort: 'date',
          subject: 'all',
          activityType: 'all',
          learningType: 'all'
        }
      });

      var preview = new Preview({
        element: $('.preview'),
        mainHeader: $('.header'),
        pageClass: 'contentSection',
        data: data,
      });

      $(document).on('click', '.card__item a', function(e) {
        e.stopPropagation();
      });
    });
  }

})(jQuery, this);

var Preview = (function() {
  'use strict';

  function Preview(options) {
    this.element = options.element;
    this.mainHeader = options.mainHeader;
    this.pageClass = options.pageClass;
    this.pageElement = $('.' + options.pageClass);
    this.data = options.data;
    this.openPreviewButton = $('[data-trigger="preview"]');
    this.previewHeader = this.element.find('.preview__header');
    this.backButton = this.element.find('.preview__backButton');
    this.previewContent = this.element.find('.preview__content');
    this.previewIntro = this.element.find('.preview__intro');
    this.title = this.element.find('.preview__title');
    this.actionButton = this.element.find('.preview__action');
    this.popover = this.element.find('.preview__popover');
    this.progressIndicator = this.element.find('.spinner');

    this.initialize();
  }

  Preview.prototype.initialize = function() {
    this.bindEvents();
    this.populateFromHistory();
  };

  Preview.prototype.bindEvents = function() {
    var self = this;

    window.onpopstate = function(event) {
      self.populateFromHistory(event.state);
    };

    $(document).on('click', '[data-trigger="preview"]', function(e) {
      e.stopPropagation();
      e.preventDefault();
      var url = $(e.currentTarget).data('url');

      self.renderDetails(url);
      window.history.pushState({}, 'Preview', '?u=' + url);
    });

    this.element.on('click', '.preview__introButton', function(e) {
      var fired = false;
      var animationEnd = 'webkitAnimationEnd oanimationend oAnimationEnd msAnimationEnd animationend';
      var popoverDismissed = sessionStorage.getItem('popoverDismissed');

      self.hideIntro();

      if (!popoverDismissed) {
        $('.preview__introScreenInner').one(animationEnd, function(e) {
          self.togglePopover(false);

          $('.preview__popoverClose').on('click', function() {
            self.togglePopover(true);
            sessionStorage.setItem('popoverDismissed', true);
          });
        });
      }
    });

    this.backButton.on('click', function() {
      history.back();
    });
  };

  Preview.prototype.toggleLoading = function(show) {
    this.progressIndicator.toggleClass('spinner--hidden', !show);
    this.previewContent.toggleClass('preview__content--hidden', show);
  };

  Preview.prototype.toggleDisplay = function(show) {
    $('body').toggleClass('previewOpen', show);
    this.mainHeader.toggleClass('header--previewOpen', show);
    this.pageElement.toggleClass(this.pageClass + '--previewOpen', show);
    this.element.toggleClass('preview--hidden', !show);
    this.togglePopover(show);
    this.previewIntro.empty();
    this.previewContent.empty();
  };

  Preview.prototype.togglePopover = function(hide) {
    this.popover.toggleClass('preview__popover--hidden', hide);
  };

  Preview.prototype.renderDetails = function(url) {
    var demo = this.data.filter(function(item) {
      return item.url === url;
    });

    var currentDemo = demo[0];
    var title = currentDemo.title;
    var id = currentDemo.lessonId;

    this.toggleDisplay(true);
    this.renderIntro(currentDemo);
    this.renderIframe(id);
    this.title.text(title);
    this.actionButton.attr('href', url);
  };

  Preview.prototype.renderIntro = function(demo) {
    var iconActivity = '<svg class="preview__introStatsIcon" xmlns="http://www.w3.org/2000/svg" width="14" height="19" viewBox="0 0 14 19"><path fill-rule="evenodd" d="M9.45 14.14l2.103 4.202 1.79-.895-2.05-4.094 2.498-1.064L7 6v9.184l2.45-1.045zM13 8.407v-5.41C13 1.343 11.657 0 10 0H3C1.34 0 0 1.343 0 3v7c0 1.658 1.343 3 3 3h2v-2H2.998c-.55 0-.998-.446-.998-.998V2.998c0-.55.446-.998.998-.998h7.004c.55 0 .998.446.998.998v3.558l2 1.852z"/></svg>';

    var iconAdaptivity = '<svg class="preview__introStatsIcon" xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 14 14"><path fill-rule="evenodd" d="M11.7 10.3L6.4 5H0v2h5.6l4.7 4.7L8 14h6V8l-2.3 2.3zm.573-9.987l1.414 1.414-4.03 4.03L8.24 4.343l4.03-4.03z"/></svg>';

    var intro =   '<div class="preview__introBackground">' +
                    '<div class="preview__introBackgroundImage" style="background-image: url(' + demo.image + ');"></div>' +
                  '</div>' +
                  '<div class="preview__introScreen preview__introScreen--hidden">' +
                    '<div class="preview__introScreenInner">' +
                      '<div class="preview__introAuthor">' +
                        '<div class="preview__introAvatar"><img src="/assets/demos/avatars/' + demo.avatar + '" alt="Picture of ' + demo.author +'"></div>' +
                        '<div class="preview__introAuthorText">' + demo.author + '</div>' +
                      '</div>' +
                      '<div class="preview__introHeader">' +
                        '<h1 class="preview__introTitle">' + demo.title + '</h1>' +
                        '<div class="preview__introSubTitle">' + demo.lessonTitle + ' by ' + demo.institution + '</div>' +
                        '<div class="preview__introStats">' +
                          '<div class="preview__introStatsItem">' + iconAdaptivity + demo.learningType + '</div>' +
                          '<div class="preview__introStatsItem">' + iconActivity + demo.activityType + '</div>' +
                        '</div>' +
                      '</div>' +
                      '<div class="preview__introDetails">' +
                        '<p class="preview__introDescription">' + demo.previewDescription + '</p>' +
                        '<button class="preview__introButton button button--primary">Begin Preview</button>' +
                      '</div>' +
                    '</div>' +
                  '</div>';

    this.previewIntro.html(intro);
    this.previewIntro.removeClass('preview__intro--hidden');
  };

  Preview.prototype.hideIntro = function() {
    this.previewIntro.addClass('preview__intro--hidden');
  };

  Preview.prototype.renderIframe = function(lessonId) {
    var self = this;
    var fired = false;
    var animationEnd = 'webkitAnimationEnd oanimationend oAnimationEnd msAnimationEnd animationend';

    var iframe = $('<iframe/>', {
      src: 'https://aelp.smartsparrow.com/ci/preview/' + lessonId + '/start',
      class: 'preview__iframe preview__iframe--hidden'
    });

    this.toggleLoading(true);

    $('.preview__introScreenInner').one(animationEnd, function(e) {
      if (!fired) {
        fired = true;
        self.previewContent.html(iframe);

        // Uncomment this for local testing
        iframe.on('load', function(){
          window.setTimeout(function() {
            self.toggleLoading(false);
            iframe.toggleClass('preview__iframe--hidden');
          }, 1000);
        });

        // Respond to post messages
        // window.onmessage = function(e){
        //   var data = JSON.parse(e.data);
        //   if (data.type === 'lesson-loaded') {
        //     self.toggleLoading(false);
        //     iframe.toggleClass('preview__iframe--hidden');
        //   }
        // };
      }
    });
  };

  Preview.prototype.populateFromHistory = function(state) {
    var uri = new URI(window.location.href);
    var hash = uri.fragment();
    var values = uri.search(true);

    if (values.hasOwnProperty('u')) {
      this.toggleDisplay(true);
      this.renderDetails(values.u);
    } else {
      this.toggleDisplay(false);
    }
  };

  return Preview;
})();

(function ($, root, undefined) {
  'use strict';

  $(function() {
    var prevArrow = $('.carousel__control--prev');
    var nextArrow = $('.carousel__control--next');

    $('.carousel__slides').slick({
      prevArrow: prevArrow,
      nextArrow: nextArrow,
      dots: true,
      dotsClass: 'carousel__dots',
      responsive: [
        {
          breakpoint: 700,
          settings: {
            arrows: false,
          }
        }
      ]
    });
  });

})(jQuery, this);

var ComponentCard = (function() {
  'use strict';

  function ComponentCard(data) {
    this.url = data.url;
    this.title = data.title;
    this.categories = data.categories;
    this.featured = data.featured;
    this.image = data.image;
    this.description = data.description;
  }

  ComponentCard.prototype.renderComponentCard = function() {
    var truncatedDesctription = this.description.substring(0, 90);
    var card =  '<a href="' + this.url + '" class="componentCard__item componentCard__item--faded">' +
                  '<div class="componentCard__thumbnail" style="background-image: url(' + this.image + ');"></div>' +
                  '<div class="componentCard__content">' +
                    '<h3 class="componentCard__title">' + this.title + '</h3>' +
                    '<p class="componentCard__description">' + truncatedDesctription + '...</p>' +
                  '</div>' +
                '</a>';
    return card;
  };

  return ComponentCard;
})();

var Catalog = (function() {
  'use strict';

  function Catalog(element, data) {
    this.data = data;
    this.element = element;
    this.catalogContent = this.element.find('.catalog__items');
    this.filterLinks = this.element.find('.sideNav__link');
    this.carousel = this.element.find('[data-content="carousel"]');
    this.featuredContent = this.element.find('[data-content="featured"]');
    this.newContent = this.element.find('[data-content="new"]');
    this.featuredCollectionContent = this.element.find('[data-content="Featured Collections"]');
    this.allCollectionContent = this.element.find('[data-content="All Collections"]');
    this.filteredContent = this.element.find('[data-content="filtered"]');
    this.filteredCardContainer = this.filteredContent.find('.componentCard');
    this.filteredContentTitle = this.filteredContent.find('.catalog__title');
    this.isMobile = window.matchMedia('(max-width: 700px)');

    this.initialize();
  }

  Catalog.prototype.initialize = function() {
    this.bindEvents();
    this.showFeatured();
    this.populateFromHistory();
    this.animateCards();
  };

  Catalog.prototype.bindEvents = function() {
    var self = this;

    $('[data-filter]').click(function(e) {
      var target = $(e.currentTarget);
      var filterName = target.data('filter');
      var filterValue = target.data('value');
      var queryString = '?n=' + filterName + '&v=' + filterValue;

      window.history.pushState({}, filterValue, queryString);
      self.changeDisplay(filterName, filterValue);
      self.scrollToContent();
    });

    window.onpopstate = function(event) {
      self.populateFromHistory();
    };
  };

  Catalog.prototype.scrollToContent = function() {
    var scrollHeight = $('.heroBanner').height() - 50;
    $(window).scrollTop(scrollHeight);
  };

  Catalog.prototype.showFeatured = function() {
    this.resetDisplay();
    this.catalogContent.append(this.carousel);
    this.catalogContent.append(this.featuredContent);
    this.catalogContent.append(this.newContent);

    this.carousel.removeClass('catalog__section--hidden');
    this.featuredContent.removeClass('catalog__section--hidden');
    this.newContent.removeClass('catalog__section--hidden');
    this.filterLinks.removeClass('sideNav__link--active');
    this.carousel.removeClass('catalog__section--faded');

    var featuredData = this.filterContent('featured', 'Featured Components', this.data);
    var newData = this.filterContent('featured', 'New and Noteworthy', this.data);

    this.renderComponentList(featuredData, this.featuredContent.find('.componentCard'), 2);
    this.renderComponentList(newData, this.newContent.find('.componentCard'), 2);
  };

  Catalog.prototype.renderComponentList = function(data, container, limit) {
    var self = this;
    container.empty();

    $.each(data, function(index, value){
      var component = new ComponentCard(value);
      var card = component.renderComponentCard();
      container.append(card);
      if (limit) return index < limit;
    });

    this.animateCards();
  };

  Catalog.prototype.animateCards = function() {
    var index = 0;
    var items = $('.componentCard__item');
    var framesPerSecond = 30;

    function animate() {
      if (index <= items.length) {
        setTimeout(function() {
          window.requestAnimationFrame(animate);
          $(items[index++]).removeClass('componentCard__item--faded');
        }, 1000 / framesPerSecond);
      }
    }

    animate();
  };

  Catalog.prototype.resetDisplay = function() {
    $('.componentCard__item').addClass('componentCard__item--faded');
    this.carousel = this.carousel.detach();
    this.featuredContent = this.featuredContent.detach();
    this.newContent = this.newContent.detach();
    this.featuredCollectionContent = this.featuredCollectionContent.detach();
    this.allCollectionContent = this.allCollectionContent.detach();
    this.filteredContent = this.filteredContent.detach();
    this.filterLinks.removeClass('sideNav__link--active');
  };

  Catalog.prototype.changeDisplay = function(filterName, filterValue) {
    var selectedLink = $('.sideNav__link[data-value="' + filterValue + '"]');

    this.resetDisplay();
    selectedLink.addClass('sideNav__link--active');

    if (filterValue === 'Featured Collections') {
      this.catalogContent.html(this.featuredCollectionContent);
      this.featuredCollectionContent.removeClass('catalog__section--hidden');
      this.animateCards();

    } else if (filterValue === 'All Collections') {
      this.catalogContent.html(this.allCollectionContent);
      this.allCollectionContent.removeClass('catalog__section--hidden');
      this.animateCards();

    } else {
      this.catalogContent.html(this.filteredContent);
      this.filteredContent.removeClass('catalog__section--hidden');
      var filteredData = this.filterContent(filterName, filterValue, this.data);
      this.renderComponentList(filteredData, this.filteredCardContainer);
    }
  };

  Catalog.prototype.search = function(query) {
    var self = this;
    var results = window.idx.search(query);
    var searchEntries = [];
    this.resetDisplay();
    this.catalogContent.append(this.filteredContent);
    this.filteredContent.removeClass('catalog__section--hidden');

    window.data.then(function(loaded_data) {

      if (results.length) {
        results.forEach(function(result) {
          searchEntries.push(loaded_data[result.ref]);
        });

        self.filteredContentTitle.text('Results for ' + query);
        self.renderComponentList(searchEntries, self.filteredCardContainer);
        self.animateCards();
      } else {
        self.filteredContentTitle.text('No results found for ' + query);
      }

      self.scrollToContent();
    });
  };

  Catalog.prototype.populateFromHistory = function() {
    var uri = new URI(window.location.search.toString());
    var queryString = uri.search(true);

    if (queryString.hasOwnProperty('n') && queryString.hasOwnProperty('v')) {
      this.changeDisplay(queryString.n.toString(), queryString.v.toString());
      if (this.isMobile.matches) this.scrollToContent();
    } else if (queryString.hasOwnProperty('q')) {
      this.search(queryString.q.toString());
    } else {
      this.showFeatured();
    }
  };

  Catalog.prototype.filterContent = function(filterName, filterValue, data) {
    this.filteredContentTitle.text(filterValue);

    var filteredData = data.filter(function(n, i) {
      var data = n[filterName].split(', ');
      return data.indexOf(filterValue) !== -1;
    });

    return filteredData;
  };

  return Catalog;
})();

$(function() {
  // Only run for catalog pages
  if ($('.catalog').length) {
    window.data.then(function(data) {
      var catalog = new Catalog($('.catalog'), data);
    });
  }
});

$(function() {
    var $versionDropdown = $('.capiTable-wrapper select');
    $versionDropdown.on('change', showSelectedTable);

    if ($versionDropdown.length) showSelectedTable();

    function showSelectedTable() {
        $('.capiTable-wrapper .table').hide();
        var version = $versionDropdown.val().replace(/\./g, '\\.');
        $('.capiTable-wrapper .table.version' + version).show();
    }
});

var Gallery = (function () {
  'use strict';

  function Gallery(element) {
    this.element = element;
    this.items = this.element.querySelectorAll('.gallery__item');
    this.modal = this.element.querySelector('.gallery__modal');
    this.modalClose = this.element.querySelector('.gallery__modalCloseButton');
    this.modalPrev = this.element.querySelector('.gallery__modalNavButton--prev');
    this.modalNext = this.element.querySelector('.gallery__modalNavButton--next');
    this.modalImage = this.modal.children[0];
    this.currentButton = null;
    this.currentImage = null;
    this.setImage = this.setImage.bind(this);
    this.openModal = this.openModal.bind(this);
    this.closeModal = this.closeModal.bind(this);
    this.handleModalControls = this.handleModalControls.bind(this);
    this.onAnimationEnd = this.onAnimationEnd.bind(this);
    this.goToNext = this.goToNext.bind(this);
    this.goToPrev = this.goToPrev.bind(this);
    this.addEventListeners();
  }

  Gallery.prototype.addEventListeners = function () {
    this.modalImage.addEventListener('click', this.closeModal);
    this.modalPrev.addEventListener('click', this.goToPrev);
    this.modalNext.addEventListener('click', this.goToNext);
    this.modalClose.addEventListener('click', this.closeModal);

    for (var i = 0; i < this.items.length; i++) {
      this.items[i].addEventListener('click', this.openModal);
    };
  }

  Gallery.prototype.openModal = function (event) {
    this.setImage(event.currentTarget);
    this.modal.classList.add('gallery__modal--open');
    this.modal.focus();
    document.addEventListener('keydown', this.handleModalControls);
  };

  Gallery.prototype.setImage = function (galleryItem) {
    this.currentImage = galleryItem.children[0];
    this.currentButton = galleryItem;
    var imageUrl = this.currentImage.dataset.url;
    var imageTitle = this.currentImage.dataset.title;
    this.modal.setAttribute('aria-label', 'Close picture of ' + imageTitle);
    this.modalImage.setAttribute('src', imageUrl);
    this.modalImage.setAttribute('alt', imageTitle);
  };

  Gallery.prototype.handleModalControls = function (event) {
    // Escape key
    if (event.keyCode === 27) {
      this.closeModal();
    };

    // Arrow right
    if (event.keyCode === 39) {
      this.goToNext();
    };

    // Arrow left
    if (event.keyCode === 37) {
      this.goToPrev();
    };
  };

  Gallery.prototype.goToNext = function () {
    var itemsArray = Array.from(this.items);
    var itemsLength = itemsArray.length;
    var currentIndex = itemsArray.indexOf(this.currentButton);

    if (currentIndex === itemsLength - 1) {
      this.setImage(itemsArray[0]);
    } else {
      this.setImage(itemsArray[currentIndex + 1]);
    }
  };

  Gallery.prototype.goToPrev = function () {
    var itemsArray = Array.from(this.items);
    var itemsLength = itemsArray.length;
    var currentIndex = itemsArray.indexOf(this.currentButton);

    if (currentIndex === 0) {
      this.setImage(itemsArray[itemsLength - 1]);
    } else {
      this.setImage(itemsArray[currentIndex - 1]);
    }
  };

  Gallery.prototype.closeModal = function () {
    this.modal.classList.add('gallery__modal--closing');
    this.modal.addEventListener('animationend', this.onAnimationEnd);
    this.currentButton.focus();
  };

  Gallery.prototype.onAnimationEnd = function () {
    document.removeEventListener('keydown', this.handleModalControls);
    this.modal.removeEventListener('animationend', this.onAnimationEnd);
    this.modal.classList.remove('gallery__modal--closing');
    this.modal.classList.remove('gallery__modal--open');
    this.modalImage.setAttribute('src', "");
    this.modalImage.setAttribute('alt', "");
  };

  return Gallery;
})();

(function () {
  'use strict';

  var galleryInstances = document.querySelectorAll('.gallery');

  if (galleryInstances.length > 0) {
    galleryInstances.forEach(function (element) {
      new Gallery(element);
    });
  }
})();

var PromoBanner = (function () {
  function PromoBanner() {
    this.banner = document.createElement('div');
    this.banner.classList.add('promo-banner');
    this.hide = this.hide.bind(this);
    this.updateDisplay = this.updateDisplay.bind(this);
    this.initialize();
  }

  PromoBanner.prototype.renderBanner = function() {
    return (
      '<div class="promo-banner__content">' +
        '<svg class="promo-banner__logo" fill="#FFF" width="491" height="130" viewBox="0 0 491 130" xmlns="http://www.w3.org/2000/svg">' +
          '<path d="M95.5 4.25h28.25V126H95.5v-12.75c-11.583 10.833-24.042 16.25-37.375 16.25-16.833 0-30.75-6.083-41.75-18.25C5.458 98.833 0 83.333 0 64.75 0 46.5 5.458 31.292 16.375 19.125 27.292 6.958 40.958.875 57.375.875c14.167 0 26.875 5.833 38.125 17.5V4.25zm-66.75 60.5c0 11.667 3.125 21.167 9.375 28.5 6.417 7.417 14.5 11.125 24.25 11.125 10.417 0 18.833-3.583 25.25-10.75 6.417-7.417 9.625-16.833 9.625-28.25 0-11.417-3.208-20.833-9.625-28.25-6.417-7.25-14.75-10.875-25-10.875-9.667 0-17.75 3.667-24.25 11-6.417 7.417-9.625 16.583-9.625 27.5zm231.375 7h-87.25c.75 10 4 17.958 9.75 23.875 5.75 5.833 13.125 8.75 22.125 8.75 7 0 12.792-1.667 17.375-5 4.5-3.333 9.625-9.5 15.375-18.5l23.75 13.25c-3.667 6.25-7.542 11.604-11.625 16.063-4.083 4.458-8.458 8.124-13.125 11-4.667 2.875-9.708 4.979-15.125 6.312-5.417 1.333-11.292 2-17.625 2-18.167 0-32.75-5.833-43.75-17.5-11-11.75-16.5-27.333-16.5-46.75 0-19.25 5.333-34.833 16-46.75C170.25 6.75 184.5.875 202.25.875c17.917 0 32.083 5.708 42.5 17.125 10.333 11.333 15.5 27.042 15.5 47.125l-.125 6.625zm-28.875-23c-3.917-15-13.375-22.5-28.375-22.5-3.417 0-6.625.52-9.625 1.563-3 1.041-5.73 2.541-8.188 4.5-2.458 1.958-4.562 4.312-6.312 7.062s-3.083 5.875-4 9.375h56.5zm49.625-44.5H309v10.875C314.167 9.708 318.75 6 322.75 4c4.083-2.083 8.917-3.125 14.5-3.125 7.417 0 15.167 2.417 23.25 7.25l-12.875 25.75c-5.333-3.833-10.542-5.75-15.625-5.75-15.333 0-23 11.583-23 34.75V126h-28.125V4.25zm80 60c0-17.583 6.292-32.542 18.875-44.875 12.583-12.333 27.917-18.5 46-18.5 18.167 0 33.583 6.208 46.25 18.625 12.5 12.417 18.75 27.667 18.75 45.75 0 18.25-6.292 33.542-18.875 45.875-12.667 12.25-28.208 18.375-46.625 18.375-18.25 0-33.542-6.25-45.875-18.75-12.333-12.333-18.5-27.833-18.5-46.5zm28.75.5c0 12.167 3.25 21.792 9.75 28.875 6.667 7.167 15.458 10.75 26.375 10.75 11 0 19.792-3.542 26.375-10.625C458.708 86.667 462 77.208 462 65.375c0-11.833-3.292-21.292-9.875-28.375-6.667-7.167-15.458-10.75-26.375-10.75-10.75 0-19.458 3.583-26.125 10.75-6.667 7.167-10 16.417-10 27.75z"/>' +
        '</svg>' +
        '<h2 class="promo-banner__title">Meet the world’s most advanced digital learning platform</h2>' +
        '<a class="promo-banner__link" href="/aero">Discover aero</a>' +
        '<button class="promo-banner__close-button" aria-label="Dismiss banner">' +
          '<svg xmlns="http://www.w3.org/2000/svg" fill="#FFF" width="24" height="24" viewBox="0 0 24 24">' +
            '<path d="M19 6.41L17.59 5 12 10.59 6.41 5 5 6.41 10.59 12 5 17.59 6.41 19 12 13.41 17.59 19 19 17.59 13.41 12z"/>' +
          '</svg>' +
        '</button>' +
      '</div>'
    );
  };

  PromoBanner.prototype.hide = function () {
    this.banner.classList.add('promo-banner--hidden');
    this.banner.classList.remove('promo-banner--visible');
    sessionStorage.setItem('hide_promo_banner', true);
  }

  PromoBanner.prototype.show = function () {
    this.banner.classList.add('promo-banner--visible');
    this.banner.classList.remove('promo-banner--hidden');
  }

  PromoBanner.prototype.initialize = function () {
    var header = document.querySelector('header');
    this.banner.innerHTML = this.renderBanner();
    this.banner.style.top = header.style.height;
    document.body.insertBefore(this.banner, header.nextSibling);
    var closeButton = this.banner.querySelector('.promo-banner__close-button');


    closeButton.addEventListener('click', this.hide);
    setTimeout(this.updateDisplay, 1000);
  }

  PromoBanner.prototype.updateDisplay = function () {
    if (sessionStorage.getItem('hide_promo_banner')) {
      this.hide();
    } else {
      this.show();
    }
  }

  return PromoBanner;
})();

(function () {
  var page = window.location.pathname;
  var showPromoBanner = page === '/' || page === '/platform/';

  if (showPromoBanner) {
    new PromoBanner();
  }
})();

