(function () {
  var hubspotForms = [].slice.call(document.querySelectorAll('.hubspot-form'));

  if (hubspotForms.length) {
    // Wait for script to load before initializing all forms
    var script = document.createElement('script');
    script.src = 'https://js.hsforms.net/forms/v2.js';
    script.type = 'text/javascript';
    script.addEventListener('load', function () {
      hubspotForms.forEach(function (form) {
        new HubspotForm({ element: form });
      });
    });

    document.body.appendChild(script);
  }
})();


